    {
      "dot": "cyan",
      "title": "数据层与 Webull 适配",
      "items": [
        "对接 Webull OpenAPI 官方协议，提取 DTE >= 250 天的远期 LEAPS 期权链",
        "内置速率控制 (Rate-Limiter) 与本地离线缓存，保障请求稳定与防频控",
        "支持生产实盘凭证接入与离线沙盒单测隔离"
      ]
    },
    {
      "dot": "emerald",
      "title": "量化与四维策略引擎",
      "items": [
        "Black-Scholes 闭式与二叉树数值定价，快速反推 IV 与全量 Greeks",
        "策略一：深度实值代正股 (Delta 0.7-0.85, 极低外在价值磨损, 2.5-4.5x 杠杆)",
        "策略二：波动率洼地 (IV Rank < 20% 或 IV/HV < 0.85 远期波动率低估)",
        "策略三：龙头超跌共振 (标普500/纳指100超跌均线偏离与基本面优选)",
        "策略四：远期异动放量 (Volume/OI > 1.5 异常大单侦测)"
      ]
    },
    {
      "dot": "rose",
      "title": "交付与可视化交互",
      "items": [
        "FastAPI 高性能微服务，原生 Swagger 文档与高并发异步 IO",
        "现代化交互式 Web 看板，支持动态滑块调优参数与收益走势图表",
        "提供命令行 CLI 实时表格输出与自动化告警触发"
      ]
