  "cards": [
    {
      "dot": "cyan",
      "title": "全局不变量与严谨定价",
      "items": [
        "P_exec 执行价滑点模型严格贯穿四大策略，绝不使用虚高 Mid 冒充买入价",
        "BS2002 美式闭式解对齐 QuantLib 金标准，IV 求解器具备 C<=S 无套利截断与 Brent 兜底"
      ]
    },
    {
      "dot": "emerald",
      "title": "策略分流与零网络重排",
      "items": [
        "标普100与纳指100覆盖150+核心资产，策略二/三强制执行90天与200日线历史门禁",
        "α 滑动条重排100%在内存中执行，重排延迟<1ms且重拉网络数据量精确为0KB"
      ]
    }
  ]
